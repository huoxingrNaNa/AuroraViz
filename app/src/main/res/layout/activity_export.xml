<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_window_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingTop="24dp"
        android:paddingRight="18dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="导出可视化视频"
            android:textColor="#FFF2F5FF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:tag="hint"
            android:text="导入音频文件渲染导出（含音轨），时长自选；也可以直接录当前监听画面（无声）"
            android:textColor="#FF6F7896"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <com.operit.audioviz.GhostButton
                android:id="@+id/btnPick"
                android:layout_width="match_parent"
                android:layout_height="44dp" />

            <TextView
                android:id="@+id/txtFile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="未选择音频"
                android:textColor="#FFF2F5FF"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:tag="hint"
                android:text="支持 mp3 / wav / flac / m4a / ogg 等"
                android:textColor="#FF6F7896"
                android:textSize="9.5sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:tag="label"
                android:text="导出时长"
                android:textColor="#FF8A93B2"
                android:textSize="10sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.operit.audioviz.ChipView
                    android:id="@+id/len0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <com.operit.audioviz.ChipView
                    android:id="@+id/len1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_weight="1" />

                <com.operit.audioviz.ChipView
                    android:id="@+id/len2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_weight="1" />

                <com.operit.audioviz.ChipView
                    android:id="@+id/len3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="导出时静音播放"
                        android:textColor="#FFF2F5FF"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:tag="hint"
                        android:text="打开后不发声，但导出的视频仍带音轨"
                        android:textColor="#FF6F7896"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/swMute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:showText="false" />
            </LinearLayout>
        </LinearLayout>

        <com.operit.audioviz.VisualizerView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="196dp"
            android:layout_marginTop="14dp" />

        <com.operit.audioviz.GradientButton
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:tag="hint"
            android:minHeight="34dp"
            android:text=""
            android:textColor="#FF6F7896"
            android:textSize="10sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:tag="hint"
            android:text="输出位置：/sdcard/Movies/AuroraViz/（相册可见）"
            android:textColor="#FF6F7896"
            android:textSize="9.5sp" />
    </LinearLayout>
</ScrollView>